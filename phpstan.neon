parameters:
    level: 9
    paths:
        - src
    bootstrapFiles:
        - vendor/autoload.php
        # Host-interface stub so src/AnidbMetadataProviderAdapter.php analyzes
        # against the real contract instead of an unknown parent (it is a
        # test/analysis-only stand-in for phlix-server's interface).
        - tests/Stub/MetadataProviderInterface.php
    treatPhpDocTypesAsCertain: false

    # Review M-ANIDB-20: the former excludePaths (the adapter) and the 13
    # ignoreErrors blocks were REAL fixes — typed boundary parsing in
    # mapToMetadataReturn, the never-null mapAnimeStatus return, removal of the
    # write-only $container property, `?? $clean` preg chains, the true ?Socket
    # property type — all shipped in this release line. There are zero
    # suppressions left; adding one re-introduces exactly what the review
    # flagged.
